# Copy to .env.local to enable accounts and cloud sync during local development.
# Values come from Supabase: Project Settings -> API (Project URL, anon/publishable key).
# The anon key is meant for browsers; row-level security keeps each account's data private.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
